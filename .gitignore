cat > .gitignore <<'EOF'
# Python environments
.venv/
.venv-*/
__pycache__/
*.py[cod]

# Secrets and credentials
.env
.env.*
!.env.example
.aws-device/
*.private.key
*.cert.pem

# Local databases and runtime files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Frontend dependencies and build output
node_modules/
dist/

# macOS
.DS_Store
EOF